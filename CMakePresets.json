{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "single-config-debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "single-config-release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with the default platform compiler.",
      "inherits": "single-config-debug",
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with the default platform compiler.",
      "inherits": "single-config-release",
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "Debug build with GCC.",
      "inherits": "single-config-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "description": "Release build with GCC.",
      "inherits": "single-config-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "description": "Debug build with Clang.",
      "inherits": "single-config-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Release build with Clang.",
      "inherits": "single-config-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-release",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "Debug build with the default Visual Studio generator.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/msvc-debug"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Release build with the default Visual Studio generator.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/msvc-release"
    },
    {
      "name": "clang-sanitizer-debug",
      "displayName": "Clang Sanitizer Debug",
      "description": "Debug build with Clang AddressSanitizer and UndefinedBehaviorSanitizer.",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/clang-sanitizer-debug",
      "cacheVariables": {
        "METHOD_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "configuration": "Debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "configuration": "Release"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "configuration": "Debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release"
    },
    {
      "name": "clang-sanitizer-debug",
      "configurePreset": "clang-sanitizer-debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-sanitizer-debug",
      "configurePreset": "clang-sanitizer-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
